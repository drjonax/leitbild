{
  "name": "leitbild-platform",
  "version": "0.5.1",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:stack": "bun --no-env-file run scripts/local-stack.ts",
    "dev:smoke": "bun --no-env-file run scripts/local-stack.ts --smoke --port=0",
    "knowledge:publish": "bun run scripts/publish-knowledge.ts",
    "check:knowledge": "bun run --cwd packages/knowledge check",
    "test:knowledge": "bun run --cwd packages/knowledge test",
    "deploy": "bun run --cwd apps/leitbild deploy",
    "check:boundaries": "bun run scripts/check-boundaries.ts",
    "check:contracts": "bun run --cwd packages/contracts check",
    "check:module-runtime": "bun run --cwd packages/module-runtime check",
    "check:procmd": "bun run --cwd packages/procmd check",
    "check:agents": "bun run --cwd apps/agents check",
    "check:world": "bun run --cwd apps/world check",
    "check:host": "bun run --cwd apps/leitbild check",
    "check:integration": "bun run --cwd packages/integration-tests check",
    "check": "bun run check:boundaries && bun run check:contracts && bun run check:module-runtime && bun run check:procmd && bun run check:knowledge && bun run check:agents && bun run check:world && bun run check:host && bun run check:integration",
    "test:contracts": "bun run --cwd packages/contracts test",
    "test:module-runtime": "bun run --cwd packages/module-runtime test",
    "test:procmd": "bun run --cwd packages/procmd test",
    "test:agents": "bun run --cwd apps/agents test:unit",
    "test:world": "bun run --cwd apps/world test",
    "test:host": "bun run --cwd apps/leitbild test",
    "test:integration": "bun run --cwd packages/integration-tests test",
    "test": "bun run test:contracts && bun run test:module-runtime && bun run test:procmd && bun run test:knowledge && bun run test:agents && bun run test:world && bun run test:host && bun run test:integration",
    "build:host": "bun run --cwd apps/leitbild build:ui",
    "build:world": "bun run --cwd apps/world build:ui",
    "build:agents": "bun run --cwd apps/agents build:ui",
    "build": "bun run build:host && bun run build:world && bun run build:agents"
  },
  "engines": {
    "bun": "1.4.0"
  },
  "devDependencies": {
    "bun-types": "1.4.0"
  }
}
