{
  "id": "halden-dispatch-roles",
  "title": "Halden emergency response exercise · dispatcher roles",
  "description": "Test-only: the civil Halden exercise with an EMS, a Police and a Fire dispatcher and a Controller, without sides, for the two-screen Board walkthrough and the live rules test. A fictional 30-minute civil dispatch exercise around Halden. Road ambulances, a medical helicopter, patrol cars and a fire engine answer medical calls, public-order calls, a building fire and a road accident; nothing is dispatched at the start. Late in the exercise a top-priority call arrives while every ambulance is busy. Calls, needs and service times are authored assumptions for demonstration, not clinical advice or claims about real services.",
  "objectives": [
    "Dispatch the recommended units to each call as it arrives.",
    "Keep top-priority calls covered, diverting a unit still on its way to a minor call when no unit is free.",
    "Let standing orders take patients to the nearest accepting hospital and bring units home."
  ],
  "world": { "startsAt": "2026-09-03T08:00:00.000Z", "environment": { "city": "Halden", "model": "Fictional civil dispatch exercise; no real patient data" } },
  "view": { "map": { "center": [11.346, 59.221], "zoom": 9.5 } },
