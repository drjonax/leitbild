{
  "name": "@leitbild/world",
  "version": "0.2.0",
  "description": "Leitbild World module runtime and map-based simulation UI",
  "type": "module",
  "module": "src/index.ts",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "start": "bun run build:ui && bun run src/index.ts",
    "dev": "bun run build:ui && bun --watch src/index.ts",
    "build:ui": "vite build",
    "check": "tsc --noEmit",
    "maps:download": "bun run scripts/maps/download-osm.ts",
    "maps:fonts": "bun run scripts/maps/install-map-fonts.ts",
    "maps:build": "bun run scripts/maps/build-vector-tiles.ts",
    "maps:scenery:build": "bun run scripts/maps/build-scenery.ts",
    "maps:scenery:audit": "bun run scripts/maps/audit-scenery.ts",
    "maps:terrain:ingest": "bun run scripts/maps/ingest-terrain.ts",
    "maps:terrain:validate": "bun run scripts/maps/validate-terrain.ts",
    "maps:terrain:bootstrap": "bun run scripts/maps/bootstrap-terrain.ts",
    "maps:terrain:audit": "bun run scripts/maps/audit-terrain.ts",
    "maps:rebuild": "bun run scripts/maps/rebuild-vector-map.ts",
    "maps:promote": "bun run scripts/maps/promote-vector-tiles.ts",
    "maps:status": "bun run scripts/maps/map-status.ts",
    "reference:build": "bun run scripts/reference/build.ts",
    "reference:promote": "bun run scripts/reference/promote.ts",
    "reference:prune": "bun run scripts/reference/prune.ts",
    "reference:status": "bun run scripts/reference/status.ts",
    "reference:rebuild": "bun run scripts/reference/rebuild.ts",
    "grid:model:build": "bun run scripts/electric-grid/build-norway-grid-model.ts",
    "process-plant:benchmark": "bun run scripts/process-plant/six-unit-benchmark.ts",
    "process-plant:acceptance": "bun run scripts/process-plant/acceptance-traces.ts",
    "process-plant:extended-validation": "bun run scripts/process-plant/extended-validation.ts",
    "process-plant:credibility": "bun run scripts/process-plant/pwr-credibility.ts",
    "process-plant:balance": "bun run scripts/process-plant/feedwater-balance-trace.ts",
    "test": "bun test --timeout 30000",
    "health": "bun run check && bun test && bun run build:ui"
  },
  "dependencies": {
    "@leitbild/knowledge": "workspace:*",
    "@leitbild/procmd": "workspace:*",
    "3d-tiles-renderer": "^0.4.28",
    "@babylonjs/core": "^9.11.0",
    "@babylonjs/loaders": "^9.11.0",
    "@deck.gl/core": "^9.3.2",
    "@deck.gl/layers": "^9.3.2",
    "@deck.gl/mapbox": "^9.3.2",
    "@leitbild/contracts": "workspace:*",
    "@leitbild/module-runtime": "workspace:*",
    "@mapbox/vector-tile": "^2.0.4",
    "@maplibre/maplibre-gl-style-spec": "^24.8.5",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "earcut": "^3.0.2",
    "fast-xml-parser": "^5.11.1",
    "h3-js": "^4.4.0",
    "hls.js": "^1.7.2",
    "lucide-svelte": "^1.0.1",
    "maplibre-gl": "6.0.0-11",
    "mermaid": "^11.15.0",
    "pbf": "^5.1.0",
    "pmtiles": "^4.4.1",
    "svelte": "^5.56.0",
    "vite": "^8.0.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@oicl/connector-diagram": "1.0.0",
    "@oicl/openbridge-webcomponents": "2.0.0",
    "@types/bun": "1.4.0",
    "harfbuzzjs": "1.6.1",
    "subset-font": "2.9.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": "1.4.0"
  }
}
