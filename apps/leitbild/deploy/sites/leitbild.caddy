leitbild.app, leitbild.ai {
	encode zstd gzip

	# The Host's root redirect uses leitbild.app as its configured public origin.
	# Keep visits to the new domain on leitbild.ai.
	@aiRoot {
		host leitbild.ai
		path /
	}
	redir @aiRoot /workspaces 303

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "frame-ancestors 'self'"
		-Server
	}

	@world path_regexp world ^(?:/workspaces/[^/]+/world(?:/.*)?|/api/workspaces/[^/]+/world(?:/.*)?|/assets/world/.*|/map/.*)$
	handle @world {
		reverse_proxy 127.0.0.1:4177
	}

	@agents path_regexp agents ^(?:/workspaces/[^/]+/agents|/api/workspaces/[^/]+/agents(?:/.*)?|/api/(?:auth|system/.*)|/assets/agents/.*)$
	handle @agents {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		reverse_proxy 127.0.0.1:3100
	}
}

samsinn.app, leitbild.samsinn.app {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	root * /opt/leitbild/current/apps/leitbild/deploy/retired
	file_server
}
