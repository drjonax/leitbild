{
  "name": "@leitbild/agents",
  "version": "0.2.0",
  "description": "Leitbild Agents module runtime",
  "module": "src/index.ts",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "start": "bun run build:ui && bun run src/main.ts",
    "start:remote": "OLLAMA_URL=http://192.168.0.222:11434 bun run start",
    "dev": "bun run build:ui && bun run scripts/dev.ts",
    "dev:remote": "OLLAMA_URL=http://192.168.0.222:11434 bun run build:ui && bun run scripts/dev.ts",
    "build:css": "bun run tailwindcss -i src/ui/input.css -o src/ui/dist.css --minify",
    "build:ui": "bun run build:css && bun run scripts/build-ui.ts",
    "dev:server": "bun --watch src/main.ts",
    "dev:css": "bun run tailwindcss -i src/ui/input.css -o src/ui/dist.css --watch",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "check:server": "tsc --noEmit",
    "check:ui": "tsc --noEmit -p tsconfig.ui.json",
    "test": "bun test",
    "test:unit": "bun test -t '^(?!.*Ollama)'",
    "headless": "bun run src/main.ts --headless",
    "health": "bash scripts/health.sh"
  },
  "keywords": ["agents", "multi-agent", "llm", "ollama", "communication", "rooms", "bun", "typescript"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelhil/leitbild"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/bun": "1.4.0",
    "dependency-cruiser": "18.2.0",
    "tailwindcss": "^4",
    "type-coverage": "2.30.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": "1.4.0"
  },
  "dependencies": {
    "@leitbild/knowledge": "workspace:*",
    "@leitbild/contracts": "workspace:*",
    "@leitbild/module-runtime": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dompurify": "^3.4.16",
    "marked": "^18.0.11",
    "unpdf": "^1.6.2",
    "zod": "^3.25 || ^4.0"
  }
}
